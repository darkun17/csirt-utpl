# ──────────────────────────────────────────────────────────────────────────────
# CSIRT UTPL — Variables de entorno
# Copia este archivo como .env.local para desarrollo local
# ──────────────────────────────────────────────────────────────────────────────

# URL base del backend Drupal (sin barra final)
# Desarrollo: http://localhost:8086
# Producción: acceso VPN únicamente (no exponer en internet)
DRUPAL_BASE_URL=http://localhost:8086

# Puerto en que corre el frontend Next.js (usado por PM2)
PORT=3005

# Entorno de ejecución
NODE_ENV=production
